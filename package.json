{
  "name": "mobile-stack",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate": "turbo run generate",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "turbo run format && biome check --write .",
    "format:check": "turbo run format:check && biome check .",
    "test": "turbo run test",
    "test:app": "turbo run test:app",
    "check": "turbo run format:check lint:check typecheck test behavior:ios behavior:android && biome check .",
    "ios": "bun run --filter @mobile-stack/ios dev",
    "android": "bun run --filter @mobile-stack/android dev",
    "doctor": "bash scripts/doctor.sh",
    "sync-ai-rules": "bash scripts/sync-ai-rules.sh",
    "rename": "bun scripts/rename.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "behavior": "turbo run behavior:ios behavior:android",
    "cli": "bash scripts/cli.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "turbo": "^2.11.13"
  }
}
